// Shared types for the Accent plugin contract.
//
// Feature f201, Epic E034: the runtime-independent WIT contract every plugin
// surface and host capability is generated from. The contract is the source
// of truth on both sides -- `wasmtime::component::bindgen!` on the host,
// `cargo-component` / `jco` in a guest.
//
// Feature f341, Epic E042 (plugin API 0.2.0): the one open-shaped value,
// `json`, became UTF-8 bytes. The 0.1 generation carried it as a flat arena
// of nodes (`record json { nodes: list<json-node> }`); that generation is
// retired, and a component built against it is refused by the host's API
// floor with a remedy.

package accent:plugin@0.2.0;

/// Types shared across every plugin surface and host capability.
interface types {
    /// One UTF-8 JSON document. Used wherever the data shape is open:
    /// frontmatter, filter values, model defaults, media metadata, data-store
    /// values. An empty list denotes the absence of a value.
    ///
    /// Typed records stay typed; only this open value crosses the boundary as
    /// bytes, because WIT forbids the recursive variant a JSON value would
    /// otherwise need. A Rust guest reads it with `serde_json::from_slice`
    /// and writes it with `serde_json::to_vec`; a JS guest decodes the bytes
    /// as UTF-8 and calls `JSON.parse`. The host refuses a non-empty payload
    /// that is not a valid JSON document, and decodes at most 128 levels of
    /// nesting.
    type json = list<u8>;

    /// Host runtime context, surfaced to every guest through the
    /// `environment` capability. Mirrors the context the Extism system
    /// injects into each hook payload today (the host context).
    record host-context {
        /// True under `--production` or in `build` mode.
        production: bool,
        /// True when `dev.debug` is enabled.
        debug: bool,
        /// Site name (`site.name`).
        site-name: string,
        /// Site base URL (`site.url`).
        site-url: string,
        /// Primary site language (`site.language`, e.g. "en").
        language: string,
    }

    /// Severity for host logging.
    enum log-level {
        debug,
        info,
        warn,
        error,
    }
}
